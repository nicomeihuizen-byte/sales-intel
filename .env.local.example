# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.
#
# There are two databases now, and .env.local decides which one the app
# talks to. See sales-intel-documentation/local-setup.md.
#
#   LOCAL  - the Supabase CLI stack on this machine, holding real pipeline
#            data. `npm run db:start` prints the URL and anon key; they are
#            the same fixed development values on every machine, which is
#            why they are safe to write down here:
#              NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#            The anon key is printed as "anon key" by `npm run db:status`.
#
#   HOSTED - the public Vercel demo, holding seeded fiction only. Its URL
#            and keys come from the Supabase dashboard.
#
# Whichever one is filled in below is the one that gets written to. Check
# it before running anything destructive.

# Supabase project URL (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key - server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key - server-only, never expose to the client
ANTHROPIC_API_KEY=

# Set to "true" to enable deleting deals and companies. Leave it
# out everywhere else, including Vercel: the hosted demo is a public page
# with a one-click login, so a delete button there is a stranger emptying
# the demo. Deliberately not NEXT_PUBLIC_ - the server actions read it, so
# the browser can neither see it nor claim it is set.
ALLOW_DESTRUCTIVE_ACTIONS=

# Which theme someone sees before they touch the toggle in the nav. Set to
# "dark" on your own copy; leave it empty everywhere else, including
# Vercel, because the hosted demo opens light on purpose - it and the case
# study page it is linked from should not be the same picture twice. Once
# a visitor uses the toggle their cookie decides and this is ignored.
DEFAULT_THEME=

# Set to "false" to hide the "back to case study" header link. That link is
# for the public demo, where visitors arrive from the portfolio page. On
# your own copy it is a link out of the tool to a page about the tool.
# Defaults to shown, so the hosted demo needs no setting at all.
SHOW_CASE_STUDY_LINK=

# Demo account credentials. Used by scripts/seed.ts, and in
# production by app/api/demo-login/route.ts (the "Live demo" button on the
# portfolio site) to sign a visitor in without ever sending the password to
# the browser. This account must exist in Supabase Auth (sign up once
# through the app, or run the seed script once) before either one works.
# Set these in Vercel's Production environment variables too, not just
# .env.local - the demo-login route runs on the deployed server.
#
# scripts/seed.ts is destructive and refuses to run unless you name the
# host you mean to wipe:
#   npm run seed -- --confirm-wipe=<host from NEXT_PUBLIC_SUPABASE_URL>
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
