# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# Supabase project URL (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key - server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key - server-only, never expose to the client
ANTHROPIC_API_KEY=

# Demo account credentials used by scripts/seed.ts. This account must exist
# in Supabase Auth (sign up once through the app) before running the seed
# script. Never used by the app itself, only by the local seed script.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
