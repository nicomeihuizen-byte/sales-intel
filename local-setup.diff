+  }
+
+  if (confirmed !== targetHost) {
+    throw new Error(
+      `Refusing to seed. You confirmed "${confirmed}" but .env.local points at "${targetHost}".\n` +
+        `Check which database NEXT_PUBLIC_SUPABASE_URL is pointing at before trying again.`,
+    );
